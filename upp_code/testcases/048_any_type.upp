Player :: struct
    age: int
    name: String
    alive: bool
         
main :: fn ()
    // The Any type in this language is a somewhat typesafe version of the C-Style void*
    // The difference is that Any also stores the type of the given value.
    // This type serves the same purpose as the tag of tagged unions.
    
    val_int: int = 5
    val_bool: bool = false
    val_player: Player = .{name = "What", age = 5, alive = true}
    
    // Everything casts automatically to any
    any_int: Any = val_int
    any_bool: Any = val_bool
    any_player: Any = val_player
    
    // As mentioned before, the any type contains a data member (*void) to the data
    // Note: Addresses are compared using ==, because address is treated similar to an int
    assert(any_int.data &== val_int-&->cast_pointer())
    assert(any_player.data &== val_player-&->cast_pointer())
    assert(any_bool.data &== val_bool-&->cast_pointer())
    
    // And also the type value, which can be used in type_info
    assert(any_player.type == Player)
    assert(any_int.type == int)
    assert(any_bool.type == bool)
    
    // Casting an any back to a value is done with an explicit cast by calling the any_cast function
    val_player_cpy: Player = any_cast(any_player)
    assert(val_player_cpy.age == val_player.age and val_player_cpy.alive == val_player.alive)
    
    // Any type variables almost behave like variables in dynamically typed languages
    i_val: i32 = 5
    u_val: u32 = 2
    assert(any_inc(i_val) == 6)
    assert(any_inc(u_val) == 4)
    assert(any_inc(false) == 0)
    
    // One of the main usecases of any will be printing/formating, because you can
    // do things like the following:
    result := mini_calc(.[5, "+", 5, "*", 2, "-", 1])
    assert(result.success)
    assert(result.value == 19)
    
    // Casting from any to a value will result in a crash if the types dont match, shown in next testcase
    
    // One of the reasons we have tagged unions, slice types and Any type
    // is that this way we have eliminated all cases where the Compiler cannot determine
    // what type is currently active, making it possible to auto - generate
    // - Printing functions
    // - Serialization functions
    // - GUI interfaces for structs
    // - Memory inspectors
    // -...
    // Maybe, if our metaprogramming system gets good enough to be able to emulate this
    // functionality, these features(Or this syntax) will be removed from the compiler.
    
any_inc :: fn (val: Any) => int
    if val.type == i32
        return val->any_cast(i32)->cast(int) + 1
    else if val.type == u32
        return val->any_cast(u32)->cast(int) + 2
    return 0

string_compare :: fn (str1: String, str2: String) => bool
    if str1.size != str2.size
        return false
    return memory_compare(str1.data, str2.data, str1.size)

Mini_Calc_Result :: struct
    success: bool
    value: int

mini_calc :: fn (ops: []Any) => Mini_Calc_Result
    i := 0
    result := 0
    Calc_Status :: enum
        ADD
        SUB
        MULT
    status := Calc_Status.ADD

    loop operation in ops
        if operation.type == int
            op_value: int = operation->any_cast()
            match status
                case .ADD
                    result += op_value
                case .SUB
                    result -= op_value
                case .MULT
                    result *= op_value
        else if operation.type == String
            string_value: String = any_cast(operation)
            if string_compare(string_value, "+")
                status = .ADD
            else if string_compare(string_value, "*")
                status = .MULT
            else if string_compare(string_value, "-")
                status = .SUB
            else                              
                return .{success = false, value = result}
        else
            ~print_string("Error invalid type")
            return .{success = false, value = result}

    return .{success = true, value = result}

