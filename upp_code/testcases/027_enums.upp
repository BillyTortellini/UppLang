Color :: enum
    RED
    GREEN
    BLUE = 17
    YELLOW
    PINK = 3
    BROWN

main :: fn ()
    // Enums are types
    color: Color
    
    // Values are assigned with Member_Access Syntax on the Enum type
    color = Color.RED
    
    // Enums can be compared with != and ==, but not with < or >
    assert(color == Color.RED)
    assert(color != Color.GREEN)
    
    // Enums are internally stored as integers, and can be cast to/from int
    casted: int = color->cast(int)
    assert(casted == 1)
    
    // Enum values are stored increasingly, starting at 1
    assert(Color.RED->cast(int) == 1)
    assert(Color.GREEN->cast(int) == 2)

    // The default values can be set with = and then they will count upwards from the given value
    Ranking :: enum
        FIRST = 4
        SECOND
        THIRD = 10
        FOURTH
     
    assert(Ranking.FIRST->cast(int) == 4)
    assert(Ranking.SECOND->cast(int) == 5)
    assert(Ranking.THIRD->cast(int) == 10)
    assert(Ranking.FOURTH->cast(int) == 11)
    
    // If values overlap, this would cause a compile-error
