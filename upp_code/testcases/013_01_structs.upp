// Structs works very similarly to C
Player :: struct
    name: String
    age: int
    alive: bool

player_make :: fn (name: String, age: int, alive: bool) => Player
    p: Player
    p.name = name
    p.age = age
    p.alive = alive
    return p

player_combine :: fn (p1: Player, p2: Player) => Player
    p: Player
    p.name = p1.name
    p.age = p1.age + p2.age
    p.alive = p1.alive or p2.alive
    return p

main :: fn ()
    p1 := player_make("Hans", 32, true)
    p2 := player_make("Dead", 132, false)
    p3 := player_make("Fred", 2000, true)
    p4 := player_combine(p1, p2)
    
    assert(p1.age == 32 and p1.alive == true)
    assert(p2.age == 132 and p2.alive == false)
    assert(p3.age == 2000 and p3.alive == true)
    assert(p4.age == 164 and p4.alive == true)
