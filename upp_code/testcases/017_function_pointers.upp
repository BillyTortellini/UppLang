add :: fn (a: int, b: int) => int
    return a + b

sub :: fn (a: int, b: int) => int
    return a - b

get_fn :: fn (do_add: bool) => &fn (a: int, b: int) => int
    if do_add 
        return add
    return sub
    
main :: fn ()
    test_fn: &fn (a: int, b: int) => int
    test_fn = add
    assert(test_fn(5, 5) == 10)
    test_fn = sub
    assert(test_fn(5, 5) == 0)
    
    assert(get_fn(true)(5, 5) == 10)
    assert(get_fn(false)(5, 5) == 0)
