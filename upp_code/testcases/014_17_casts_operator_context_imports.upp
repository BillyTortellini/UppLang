// As to not have to repeat the operator context,
// It is possible to import all used operators from other modules

import "import_test/auto_casts.upp" as Auto_Casts
import [ operators ]Auto_Casts 

main :: fn ()
    i := 15
    bool1: bool = i 
    i = 16
    bool2: bool = i
    assert(not bool1)
    assert(bool2)
