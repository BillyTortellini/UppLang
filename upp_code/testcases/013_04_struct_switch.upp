Address :: struct
    .>IPv4
        bytes: [4]u8
    .>IPv6
        bytes: [8]u8
        is_local: bool
    .>House
        zip_code: int
        street: String

test :: fn (a: Address) => int
    match a
    case .>House => house
        return house.zip_code * 2
    case .>IPv4 => v4
        sum := 0
        loop i in v4.bytes
            sum = sum + i->cast()
        return sum
    case .>IPv6 => v6
        if v6.is_local
            return 10
        return 1
    
    return -1

main :: fn ()
    p1 := Address.>House.{10, "Frank-street"}
    p2 := Address.>IPv6.{.[0, 8, 8, 8, 8, 8, 8, 7], true}
    p3 := Address.>IPv4.{.[127, 0, 0, 1]}
    
    assert(test(p1) == 20)
    assert(test(p2) == 10)
    assert(test(p3) == 128)
