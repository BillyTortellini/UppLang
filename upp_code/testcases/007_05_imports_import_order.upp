// Different imports are resolved at differerent times, in this order:
//  1. File-Imports
//  2. operator imports [all symbols operators]
//  3. alias imports (in order)

// So this still works, because files are imported first
import B as C
import A as B
import "import_test/A.upp" as A

// Also this works, because the file-import is resolved before the [all] import before the alias (as) import
import b_return_100 as return_100
import [all]B_Module
import "import_test/B.upp" as B_Module

main :: fn ()
    x := C~a_adder(3, 4)
    assert(x == 7)
    assert(return_100() == 100)
