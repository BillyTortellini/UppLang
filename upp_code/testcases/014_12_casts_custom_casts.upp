int_to_bool :: fn (a: int) => bool
    return a % 2 == 0

main :: fn ()
    // The operator-context allows users to define custom casts
    operators add_auto_cast(int, bool, int_to_bool)
    
    value: int = 15
    boolean: bool = value
    assert(not boolean)
    boolean = 12
    assert(boolean)
