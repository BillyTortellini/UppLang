// Custom casts also work on polymorphic functions
Optional :: struct ($T: Type_Handle)
    value: T
    available: bool

is_available :: fn (opt: Optional($T)) => bool
    return opt.available

main :: fn ()
    operators add_auto_cast(Optional($T), bool, is_available)
    value: Optional(int) = .{15, true}

    if value
        assert(true)
    else
        assert(false)

