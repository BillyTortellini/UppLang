Player :: struct
    name: String
    level: int
    alive: bool

init_fn :: fn () => int
    return 15 + 20 * 2

// Global initialiization order is dependent on symbol-resolution
// Normally top to bottom

global global_x: int
global global_y: int = 5
global global_w := init_fn()
global global_player: Player
global global_pointer: &int

main :: fn ()
    // Test globals
    global_x = 15 + global_y
    assert(global_x == 20)
    assert(global_w == 55)
    
    global_player.name = "Fred"
    global_player.level = 15
    global_player.alive = true
    assert(global_player.level == 15)
    assert(global_player.alive == true)
    
    // Test pointers to globals
    ptr :&= global_x-&
    ptr-* = 30
    assert(global_x == 30)
    global_pointer &= ptr
    global_pointer-* = 15
    assert(ptr-* == 15)
