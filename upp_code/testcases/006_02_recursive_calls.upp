// Recursive functions
fib :: fn (n: int) => int
    if (n <= 1)
        return 1
    return fib(n - 1) + fib(n - 2)

// Double recursive functions
rec0 :: fn (n: int) => bool
    if n <= 0
        return true
    return rec1(n - 1)

rec1 :: fn (n: int) => bool
    if n <= 0
        return true
    return rec0(n - 1)

main :: fn ()
    assert(fib(5) == 8)
    assert(rec0(20))
