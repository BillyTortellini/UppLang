main :: fn ()
    // Casting is done using the builtin cast-function
    // Signature: cast(value, to_type, from_type, value)
    
    // Integer size up and down casts
    n0: i8 = 16
    n1: i16 = cast(n0, i16)
    n2: i32 = cast(n0, i32)
    n3: i64 = cast(n0, i64)
    n4: i16 = cast(n3, i16)
    
    // Unsigned to signed integers between integers of same size
    // Cast can also be applied as a fastcall operation
    n5: u32 = n2->cast(u32)
    n6: i32 = n5->cast(i32)
    n7: u8 = cast(n0, u8)
    n8: i8 = cast(n7, i8)
    
    // Floats can also be upcast and downcast in size
    f0: f32 = 10.5
    f1: f64 = f0->cast(f64)
    f2: f32 = f1->cast(f32)
    
    // Also float to integer casts are also supported
    n9: i32 = cast(f2, i32)
    f3: f64 = cast(n0, f64)


