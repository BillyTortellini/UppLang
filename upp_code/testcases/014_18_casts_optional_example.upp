import ~print_string

Optional :: struct ($T)
    value: T
    available: bool

optional_make_success :: fn (value: $T) => Optional(T)
    return .{value = value, available = true}

optional_make_failure :: fn () => Optional($T)
    result: Optional(T)
    result.available = false
    return result

optional_unwrap :: fn (optional: Optional($T)) => T
    assert(optional.available)
    return optional.value

optional_is_available :: fn (optional: Optional($T)) => bool
    return optional.available

print_optional_int :: fn (optional: Optional(int))
    if optional.available
        ~print_int(optional.value)
    else
        print_string("Optional not available")
    print_string("\n")

optional_int_is_even :: fn (value: Optional(int)) => bool
    if not value.available
        return false
    return value.value % 2 == 0

main :: fn ()
    val := 15
    x := optional_make_success(val)
    y: Optional(int) = optional_make_failure()

    operators add_auto_cast(Optional($T), bool, optional_is_available)
    operators add_auto_cast($T, Optional(T), optional_make_success)

    assert(optional_int_is_even(16))

    b1: bool = x
    b2: bool = y
    assert(b1)
    assert(not b2)
