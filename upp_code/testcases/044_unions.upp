RGBA :: union
    value: i32
    raw: [4]u8

main :: fn ()
    // Unions work the same as in C, e.g. the members occupy the same space in memory.
    rgba: RGBA
    rgba.raw[0] = 1
    rgba.raw[1] = 1
    rgba.raw[2] = 1
    rgba.raw[3] = 1
    assert(rgba.raw[0] == 1 and rgba.raw[1] == 1 and rgba.raw[2] == 1 and rgba.raw[3] == 1)

    // Also this should really never work in a release build, as this is
    // undefined behavior, C rules apply (Only the last written union member is valid to access).
    // To do a behavior like the one above, use memcpy (Pointer casts also dont work because of Strict-Aliasing)
           
    // When writing to value, this
    // also writes to raw, as they occupy the same memory
    rgba.value = 0
    assert(rgba.raw[0] == 0 and rgba.raw[1] == 0 and rgba.raw[2] == 0 and rgba.raw[3] == 0)
    
    // The size of the type is also only 4 bytes,
    // which confirmes that the members must overlap
    info := type_info(RGBA)
    assert(info.size == 4)
