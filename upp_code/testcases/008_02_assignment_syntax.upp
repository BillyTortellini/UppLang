main :: fn ()
    // Because Pointers are treated like normal values in this language,
    // a normal syntax for assignments / definition would cause ambiguities,
    // which is why there is new syntax for some of these things
    
    integer: int
    pointer: &int 
    
    // Assignment to normal values is done with '=', as expected
    integer = 15
    // But assigning an address to a pointer value is done with '&='
    pointer &= integer

    assert(integer == 15)
    assert(pointer == 15)

    // A change to the pointer also changes the value
    pointer-* = 5
    assert(integer == 5)

    // To make the pointer point to a different value, &= needs to be used again
    other := 420
    pointer &= other
    assert(pointer == 420)
    
    // The same syntax but with assign-infer:
    scope
        i := 15
        ip :&= i
        copy := i
        i = 16
        
        assert(i == 16)
        assert(ip == 16)
        assert(copy == 15)
    
    // In some template-scenarios we may still want to have 
    // the behavior of a C assignment, which is done with '|='
    scope
        i :|= 1
        ip :|= i-&
        copy :|= i
        
        i |= 2
        assert(ip == 2 and copy == 1)
        
        cp :|= copy-&
        ip |= cp
        copy = 5
        assert(ip == 5)
