main :: fn ()
    // New operator with () creates a slice
    value_array: [20]int

    value_slice := ([]int).{value_array.data, value_array.size}
    loop i := 0; i < value_slice.size; i += 1
        value_slice[i] = value_slice.size - i - 1
    
    array_bubble_sort(value_slice)
    loop i := 0; i < value_slice.size - 1; i += 1
        assert(value_slice[i] < value_slice[i + 1])

array_bubble_sort :: fn (a: []int)
    loop i := 0; i < a.size - 1; i += 1
        loop j := i + 1; j < a.size; j += 1
            if a[j] < a[i]
                swap := a[i]
                a[i] = a[j]
                a[j] = swap
